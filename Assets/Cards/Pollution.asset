  id: carta_004
  titulo: A City in Crisis
  arteCarta: {fileID: 3088667496719285184, guid: c3645a725579eaa4594f57de49b4636a, type: 3}
  descricao: A city is suffering from dangerously high levels of pollution. Will
    you take action?
  contratar:
    textoResultado: You decide to build a giant, ultra-resistant glass dome over
      the city, preventing anyone from entering or leaving, accidentally creating
      one of the greatest animated movies of all time and making a massive profit
      in the process.
    deltaDinheiro: 30000
    arteResultado: {fileID: 0}
  naoContratar:
    textoResultado: You decide not to invest in any cleanup programs for the city,
      leaving the pollution problem to grow even worse. As a result, your reputation
      with the public takes a serious hit.
    deltaDinheiro: -45000
    arteResultado: {fileID: 0}
