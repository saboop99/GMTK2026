  m_Name: Physics
  m_EditorClassIdentifier: Assembly-CSharp::CardData
  id: carta_005
  titulo: The Physicist's Research
  arteCarta: {fileID: 4629128208902398642, guid: cb265dad827fb654aaf93c3cb60a410f, type: 3}
  descricao: Robert R. Robert is a renowned professor and physicist working to create
    a more powerful form of energy than anything ever developed. Robert is currently
    using promethium in his research, but he is seeking investors to switch to a
    hydrogen-based energy source. Will you invest in his research?
  contratar:
    textoResultado: You invest in Robert's hydrogen-based energy project, providing
      him with hydrogen capsules. As the research progresses, he discovers a stable,
      safe, and affordable way to generate energy using only hydrogen. He may even
      win a Nobel Prize for his discovery, bringing you massive profits and recognition.
    deltaDinheiro: 1000
    arteResultado: {fileID: 0}
  naoContratar:
    textoResultado: You refuse to invest, forcing Robert to continue using promethium.
      A lack of safety precautions causes the radioactive material to contaminate
      the entire building, resulting in a massive environmental disaster. Since you
      chose not to invest, your reputation remains intact.
    deltaDinheiro: 0
    arteResultado: {fileID: 0}
